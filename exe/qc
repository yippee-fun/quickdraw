#!/usr/bin/env ruby
# frozen_string_literal: true

# Opens a file's counterpart (its test, or the file a test is for) in $EDITOR.

require_relative "../lib/quickdraw"
require "shellwords"
require "stringio"

output = StringIO.new
status = Quickdraw::Commands::Counterpart.new(ARGV, io: output).call
exit(status) unless status == 0

exec(*Shellwords.split(ENV.fetch("EDITOR", "zed")), output.string.chomp)
